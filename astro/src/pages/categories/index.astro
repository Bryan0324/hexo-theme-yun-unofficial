---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Build category → count map
const catMap = new Map<string, number>();
for (const post of allPosts) {
  for (const cat of post.data.categories ?? []) {
    catMap.set(cat, (catMap.get(cat) ?? 0) + 1);
  }
}
const categories = [...catMap.entries()].sort((a, b) => b[1] - a[1]);

const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))];
---

<BaseLayout
  title="Categories"
  postCount={allPosts.length}
  categoryCount={categories.length}
  tagCount={allTags.length}
>
  <div class="hty-card">
    <h1>Categories</h1>
    <ul style="list-style:none;padding:0;margin:0;">
      {categories.map(([cat, count]) => (
        <li style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0;border-bottom:1px dashed var(--hty-border-color);">
          <Icon name="ri:folder-2-line" size={16} />
          <a href={`/categories/${encodeURIComponent(cat)}/`} style="flex:1;">{cat}</a>
          <span style="color:var(--hty-gray-color);">{count}</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
