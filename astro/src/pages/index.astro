---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_CONFIG } from '../config';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Sort by sticky (desc) then by date (desc)
const posts = allPosts.sort((a, b) => {
  const stickyA = a.data.sticky ?? (a.data.top ? 1 : 0);
  const stickyB = b.data.sticky ?? (b.data.top ? 1 : 0);
  if (stickyA !== stickyB) return stickyB - stickyA;
  return b.data.date.getTime() - a.data.date.getTime();
});

const allCategories = [...new Set(allPosts.flatMap((p) => p.data.categories ?? []))];
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))];
---

<BaseLayout
  postCount={allPosts.length}
  categoryCount={allCategories.length}
  tagCount={allTags.length}
>
  {SITE_CONFIG.banner.enable && <Banner />}

  <section id="recent-posts" class="flex flex-col">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}

    {posts.length === 0 && (
      <div class="hty-card" style="text-align:center;padding:3rem;">
        <p>No posts yet. Start writing!</p>
      </div>
    )}
  </section>
</BaseLayout>
