---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, updated, tags, categories, toc } = post.data;

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = sorted.findIndex((p) => p.slug === post.slug);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-CA');
}

const allCategories = [...new Set(allPosts.flatMap((p) => p.data.categories ?? []))];
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))];
---

<BaseLayout
  title={title}
  postCount={allPosts.length}
  categoryCount={allCategories.length}
  tagCount={allTags.length}
>
  <div id="post">
    <article class="hty-card post-block" itemscope itemtype="https://schema.org/Article">
      <header class="post-header">
        <h1 class="post-title" itemprop="name headline">{title}</h1>
        <div class="post-meta">
          <span class="post-meta-item">
            <Icon name="ri:calendar-line" size={14} />
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
          </span>
          {updated && (
            <span class="post-meta-item">
              <Icon name="ri:refresh-line" size={14} />
              <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          )}
          {categories && categories.length > 0 && (
            <span class="post-meta-item">
              <Icon name="ri:folder-2-line" size={14} />
              {categories.map((cat) => (
                <a href={`/categories/${encodeURIComponent(cat)}/`}>{cat}</a>
              ))}
            </span>
          )}
        </div>
      </header>

      <div class="markdown-body" itemprop="articleBody">
        <Content />
      </div>

      {tags && tags.length > 0 && (
        <div class="tag-cloud" style="margin-top:1.5rem;">
          {tags.map((tag) => (
            <a class="tag-item" href={`/tags/${encodeURIComponent(tag)}/`}>
              <Icon name="ri:price-tag-3-line" size={12} />
              {tag}
            </a>
          ))}
        </div>
      )}
    </article>

    {(prev || next) && (
      <nav class="post-nav">
        {next && (
          <a class="post-nav-item" href={`/posts/${next.slug}/`} style="text-align:right;">
            <div class="post-nav-label">
              <Icon name="ri:arrow-left-line" size={12} /> Previous
            </div>
            <div>{next.data.title}</div>
          </a>
        )}
        {prev && (
          <a class="post-nav-item" href={`/posts/${prev.slug}/`}>
            <div class="post-nav-label">
              Next <Icon name="ri:arrow-right-line" size={12} />
            </div>
            <div>{prev.data.title}</div>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
